# Node
node_modules/
/node

# Local agent/tool configuration
reasonix.toml

# Pure/patched core zip backup. The pristine core is stored OUTSIDE
# assets (in tools/orig/) so it never ships in the APK; it's not archived to git
# either (large dev-only payload, regenerated by the patch script as needed).
tavern-app/tools/orig/

# OS
.DS_Store
Thumbs.db

# Local dev scratch: device/emulator APK snapshots and extension sources
# exported for compatibility work; not part of the project.
/build/

# Secrets and local credentials
.env
.env.*
*.jks
*.keystore
*.p12
*.pem
*.key
*.b64
*.zip
secrets*.json

# Self-compiled Node runtime for the Android shell (~235 MB across two ABIs).
# Rebuilt locally per HANDOFF.md; never archived to git.
tavern-app/app/src/main/jniLibs/**/*.so